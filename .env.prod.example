# Production template — copy to .env on the server and fill in the values.
# The .env file is gitignored — never commit real credentials.
# Same variables as .env.example (see it for the full documentation of each
# key); only the URLs and the security notes differ.

# ---------- Database ----------
# Generate a real password: openssl rand -hex 24
POSTGRES_USER=saveboxd
POSTGRES_PASSWORD=
POSTGRES_DB=saveboxd
# Must embed the same password (host "postgres" = compose service name)
DATABASE_URL=postgresql://saveboxd:CHANGE_ME_SAME_PASSWORD@postgres:5432/saveboxd

# ---------- Auth ----------
# Generate: openssl rand -hex 32
JWT_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# ---------- IGDB (game catalog) ----------
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=

# ---------- Steam ----------
# Re-create (or update) the key at https://steamcommunity.com/dev/apikey
# with domain: saveboxd.com
STEAM_API_KEY=

# ---------- PlayStation / Xbox service credentials ----------
PSN_SERVICE_NPSSO=
XBL_API_KEY=

# ---------- OAuth 2.0 ----------
# The callback URLs below must be registered VERBATIM in each provider's
# console (42 intra / Google Cloud / Discord developers) — they are the
# production equivalents of the localhost ones.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://saveboxd.com/api/auth/google/callback
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_CALLBACK_URL=https://saveboxd.com/api/auth/discord/callback

# Where OAuth callbacks redirect back into the SPA once cookies are set,
# and where verify-email / reset-password links point
FRONTEND_URL=https://saveboxd.com

# ---------- Email (verification + password reset) ----------
# See .env.example for the MAIL_FROM/DMARC caveats. With the domain in hand,
# the clean setup is a sender like no-reply@saveboxd.com verified with your
# SMTP provider (Brevo/Resend/SendGrid… free tiers are enough).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Saveboxd <no-reply@saveboxd.com>"

# ---------- Game description translation (optional) ----------
DEEPL_API_KEY=
