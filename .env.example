# Copy this file to .env and fill in the values.
# The .env file is gitignored — never commit real credentials.

# ---------- Database ----------
POSTGRES_USER=saveboxd
POSTGRES_PASSWORD=changeme
POSTGRES_DB=saveboxd
# Used by the backend (host "postgres" = docker-compose service name)
DATABASE_URL=postgresql://saveboxd:changeme@postgres:5432/saveboxd

# ---------- Auth ----------
JWT_SECRET=change-me-to-a-long-random-string
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# ---------- IGDB (game catalog) — https://api-docs.igdb.com ----------
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=

# ---------- Steam (account linking, library import, friend suggestions) ----
# Create at https://steamcommunity.com/dev/apikey (domain: localhost).
# The OpenID sign-in works without it; library/friends/persona-name need it.
STEAM_API_KEY=

# ---------- PlayStation (psn-api — trophies/games/friends import) ----------
# PSN has no public API/OAuth, so the backend holds ONE service session and
# uses it to read the PUBLIC profiles that users declare by their PSN Online
# ID (like infinitebacklog). Paste ONE NPSSO token here (a 64-char value from
# https://ca.account.sony.com/api/v1/ssocookie after signing in at
# playstation.com with the account you want to use as the service session).
# It expires roughly every 2 months — regenerate it then. Without it, the
# PlayStation linking feature returns "not configured".
PSN_SERVICE_NPSSO=
# m.np.playstation.com sits behind an Akamai WAF that blocks datacenter/VPS IPs
# outright (verified: our prod server gets a 403 before Sony's app logic even
# sees the request) — PSN reads silently stop working the moment this runs
# somewhere other than a residential connection. Point this at a residential
# proxy (http://user:pass@host:port) to fix that; leave empty for local dev,
# where the direct connection already works fine.
PSN_PROXY_URL=

# ---------- Xbox (OpenXBL — library import via gamertag) ----------
# Xbox has no open API, so the backend holds ONE OpenXBL service key and uses it
# to read the PUBLIC profiles that users declare by their gamertag (same model
# as PSN_SERVICE_NPSSO). Get a free key by signing in with a Microsoft/Xbox
# account at https://xbl.io — the key is shown on the console (requires phone
# verification on their side). Without it, the Xbox linking feature returns
# "not configured".
XBL_API_KEY=

# ---------- OAuth 2.0 ----------
# Register apps at https://profile.intra.42.fr/oauth/applications and
# https://console.cloud.google.com/apis/credentials — redirect URIs must
# match the *_CALLBACK_URL values below exactly.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://localhost:8443/api/auth/google/callback
# Register an app at https://discord.com/developers/applications — add the
# redirect below under OAuth2 > Redirects, exactly as written.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_CALLBACK_URL=https://localhost:8443/api/auth/discord/callback

# Where OAuth callbacks redirect back into the SPA once cookies are set,
# and where verify-email / reset-password links point
FRONTEND_URL=https://localhost:8443

# ---------- Email (verification + password reset) ----------
# Generic SMTP — works with any provider's SMTP relay (SendGrid, Resend,
# Mailgun, Brevo, Amazon SES...). Without real credentials, emails just fail
# to send (logged as a warning) — signup/reset requests still succeed either
# way. SMTP_PORT=587 uses STARTTLS; use 465 for implicit TLS if your provider
# requires it.
#
# MAIL_FROM must NOT be a @gmail.com / @outlook.com / @yahoo.com (etc.)
# address: those domains publish a strict DMARC policy that only Google's/
# Microsoft's/Yahoo's own servers can satisfy, so mail relayed through any
# third-party SMTP provider claiming to be "From" one of those addresses
# gets silently dropped or spam-filtered by the recipient — even though the
# SMTP relay itself accepts and "queues" it without error. Use an address on
# a domain you've verified with your SMTP provider (see their dashboard).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Saveboxd <no-reply@saveboxd.local>"

# ---------- Game description translation (optional) ----------
# Machine-translates game descriptions on first view per language, then
# caches the result — see GameTranslation in schema.prisma. Without any key,
# falls back automatically to the free, keyless MyMemory API (lower quality,
# rate-limited) — the feature works out of the box either way.
# Preferred: DeepL API Free — https://www.deepl.com/pro-api, sign up for
# "DeepL API Free" (500k chars/month, NO credit card required). Key looks
# like xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx:fx
DEEPL_API_KEY=
