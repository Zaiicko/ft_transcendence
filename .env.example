# Copy this file to .env and fill in the values.
# The .env file is gitignored — never commit real credentials.

# ---------- Database ----------
POSTGRES_USER=saveboxd
POSTGRES_PASSWORD=changeme
POSTGRES_DB=saveboxd
# Used by the backend (host "postgres" = docker-compose service name)
DATABASE_URL=postgresql://saveboxd:changeme@postgres:5432/saveboxd

# ---------- Auth ----------
JWT_SECRET=change-me-to-a-long-random-string

# ---------- IGDB (game catalog) — https://api-docs.igdb.com ----------
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=

# ---------- OAuth 2.0 ----------
FORTYTWO_CLIENT_ID=
FORTYTWO_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
