// Saveboxd database schema — PostgreSQL via Prisma.
// Sync in dev with `npx prisma db push` (done automatically at container start).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Enums ----------

enum AuthProvider {
  LOCAL
  FORTYTWO
  GOOGLE
  STEAM
  DISCORD
}

enum FriendshipStatus {
  PENDING
  ACCEPTED
}

enum VerificationTokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

enum PlayStatus {
  PLAYED
  PLAYING
  BACKLOG
}

enum NotificationType {
  FRIEND_REQUEST
  FRIEND_ACCEPT
  REVIEW_LIKE
  REVIEW_COMMENT
  COMMENT_REPLY
  NEW_MESSAGE
  FRIEND_JOINED
  ACHIEVEMENT
  GAME_INVITE
}

enum CoverGuessStatus {
  LOBBY
  PLAYING
  FINISHED
  ABANDONED
}

enum ScreenshotGuessStatus {
  LOBBY
  PLAYING
  FINISHED
  ABANDONED
}

enum PanoramaGuessStatus {
  LOBBY
  PLAYING
  FINISHED
  ABANDONED
}

enum UserRole {
  USER
  ADMIN
}

enum ReportTargetType {
  REVIEW
  COMMENT
}

enum ReportReason {
  SPAM
  HARASSMENT
  HATE_SPEECH
  SPOILER
  OTHER
}

enum ReportStatus {
  PENDING
  RESOLVED
  DISMISSED
}

enum FeedbackStatus {
  OPEN
  RESOLVED
}

// ---------- Users & social ----------

model User {
  id               Int          @id @default(autoincrement())
  email            String       @unique
  username         String       @unique
  // Lowercased mirror of `username`, kept in sync on every write: makes
  // lookup/uniqueness case-insensitive ("Alice" and "alice" are the same
  // account) while `username` itself still stores the case the user chose.
  usernameLower    String       @unique
  // Null for OAuth-only accounts
  passwordHash     String?
  avatarUrl        String?
  bio              String?
  provider         AuthProvider @default(LOCAL)
  providerId       String?
  steamId          String?      @unique
  // Steam achievement cache (Steam has no batch call, so it is one request per
  // game). Once synced we store { syncedAt, perGame: { appId: [earned, total] } }
  // here to avoid reloading everything on each view. Cleared on (un)link.
  steamAchievements Json?
  // Linked Discord account (a secondary login, like steamId). Also acts as the
  // login identifier for accounts created through Discord.
  discordId        String?      @unique
  // Linked PlayStation account: the user declares their PSN Online ID and the
  // backend resolves it to an accountId through its own PSN service session
  // (one server-side session, see PSN_SERVICE_NPSSO). No per-user token is
  // stored. accountId drives friend matching, onlineId is for display.
  // Import-only from public profiles — not a way to sign in. No @unique:
  // linking proves nothing (we only read a public profile), so reserving an
  // accountId would lock someone else out of their own.
  psnAccountId     String?
  psnOnlineId      String?
  // PSN library cache (trophy titles + summary), same idea as xboxLibrary and
  // steamAchievements: avoids calling PSN on every view, where a transient
  // error used to show a bogus "private profile". Resynced on ?refresh=true,
  // cleared on (un)link.
  psnLibrary       Json?
  // Linked Xbox account: the user declares their public gamertag, the backend
  // resolves it to a XUID with its OpenXBL service key (one server-side key,
  // see XBL_API_KEY) and reads their public games and achievements. No per-user
  // token. xuid identifies the profile, gamertag is for display. Import-only
  // from public profiles — not a way to sign in. Mirrors psnAccountId, and has
  // no @unique for the same reason.
  xboxXuid         String?
  xboxGamertag     String?
  // Xbox library cache (OpenXBL returns ~1000 titles, slow to reload each
  // view). Once fetched we store { syncedAt, titles: [...] } and only resync on
  // ?refresh=true. Cleared on (un)link. Counterpart of steamAchievements.
  xboxLibrary      Json?
  // Whether OTHER users can view this account's linked libraries (the
  // "View library" button on the public profile / GET .../library/:username
  // endpoints). Never affects the owner's own view, nor the background
  // completion sync — only what a visitor can see. Public by default: the
  // underlying platform profile is public too (that's how we can read it at
  // all), so this is an explicit opt-out, not an opt-in.
  libraryPublic    Boolean      @default(true)
  twoFactorSecret  String?
  twoFactorEnabled Boolean      @default(false)
  language         String       @default("en")
  // Per-type notification preferences: { REVIEW_LIKE: false, ... }.
  // Absent or true means enabled (opt-out); null means everything is on.
  notificationPrefs Json?
  // Null until the address is confirmed via the emailed verification link
  // (set immediately on OAuth signup, since the provider already verified it)
  emailVerifiedAt  DateTime?
  // Last WebSocket disconnect time — used for "last seen" once offline
  lastSeenAt       DateTime?
  // Onboarding wizard completion: null until the wizard is finished or
  // explicitly skipped; while null the front redirects to /welcome.
  onboardedAt      DateTime?
  // Guided "what each button does" tour: null until seen or skipped. Fires once,
  // right after onboarding, and can be replayed from the settings menu without
  // resetting this field.
  tutorialSeenAt   DateTime?
  // Per-platform 100% completion seeding: { steam?: true, xbox?: true,
  // psn?: true }. A platform's first sync records what already exists WITHOUT
  // pushing to the feed (every old 100% would announce at once) and marks the
  // platform here; afterwards only new completions emit.
  completionSeed   Json?
  // Last background completion resync attempt (see CompletionsService). Paces
  // the cron: an account is only "due" when this is null or stale. Bumped on
  // EVERY attempt, failures included, so a private profile isn't hammered.
  completionCheckedAt DateTime?
  // No self-service path: promote via `UPDATE "User" SET role = 'ADMIN'`.
  role             UserRole     @default(USER)
  // Set by an admin (PATCH /users/:id/ban). Enforced in AuthService.issueTokens
  // — every login/refresh/2FA-completion path funnels through it — rather
  // than on every request via the JWT strategy, so a ban takes effect within
  // one access-token lifetime (default 15m) without an extra DB read per request.
  bannedAt         DateTime?
  bannedReason     String?
  // Marks the single reserved "Admin" bot account used to deliver feedback
  // replies (FeedbackService) — never a real login. ChatService lets a
  // system account message/be messaged by anyone, bypassing the normal
  // friends-only gate, and surfaces the thread in listConversations() even
  // without a Friendship row: replying to feedback must never silently
  // friend the real admin's personal account with a stranger.
  isSystemAccount  Boolean      @default(false)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  reviews               Review[]
  gameCompletions       GameCompletion[]
  reviewLikes           ReviewLike[]
  reviewDislikes        ReviewDislike[]
  reviewComments        ReviewComment[]
  reviewCommentLikes    ReviewCommentLike[]
  reviewCommentDislikes ReviewCommentDislike[]
  playedGames           PlayedGame[]
  gameLists          GameList[]
  sentFriendships    Friendship[]   @relation("FriendshipRequester")
  receivedFriendships Friendship[]  @relation("FriendshipAddressee")
  sentMessages       Message[]      @relation("MessageSender")
  receivedMessages   Message[]      @relation("MessageRecipient")
  sharedInMessages   Message[]      @relation("MessageSharedUser")
  notifications      Notification[]
  refreshTokens      RefreshToken[]
  verificationTokens VerificationToken[]
  milestonesAsSubject LeaderboardMilestone[] @relation("MilestoneSubject")
  milestonesAsViewer  LeaderboardMilestone[] @relation("MilestoneViewer")
  achievements        UserAchievement[]
  coverGuessMatches   CoverGuessMatch[]
  screenshotGuessMatches ScreenshotGuessMatch[]
  panoramaGuessMatches PanoramaGuessMatch[]
  reportsMade         Report[] @relation("ReportsMade")
  reportsResolved     Report[] @relation("ReportsResolved")
  reportsAsTarget     Report[] @relation("ReportsTargetAuthor")
  feedbackSubmitted   Feedback[] @relation("FeedbackSubmitted")
  feedbackResolved    Feedback[] @relation("FeedbackResolved")
}

// Opaque refresh tokens (rotated on use) backing the short-lived JWT access token
model RefreshToken {
  id         Int       @id @default(autoincrement())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     Int
  // SHA-256 hash of the token — the raw value only ever lives in the client's cookie
  tokenHash  String    @unique
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
}

// Opaque tokens backing "verify my email" and "reset my password" links —
// same hash-only-at-rest pattern as RefreshToken.
model VerificationToken {
  id        Int                   @id @default(autoincrement())
  user      User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    Int
  type      VerificationTokenType
  tokenHash String                @unique
  expiresAt DateTime
  createdAt DateTime              @default(now())
}

model Friendship {
  id          Int              @id @default(autoincrement())
  requester   User             @relation("FriendshipRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  requesterId Int
  addressee   User             @relation("FriendshipAddressee", fields: [addresseeId], references: [id], onDelete: Cascade)
  addresseeId Int
  status      FriendshipStatus @default(PENDING)
  createdAt   DateTime         @default(now())

  @@unique([requesterId, addresseeId])
}

// Leaderboard milestone: the moment a user (subject) enters a leaderboard's top
// 3, so the feed can show it. `scope` is 'global' (viewerId null, visible to
// all their friends) or 'friends' (viewerId is the observer whose circle is
// concerned, since "top 3 of your friends" is relative to each person).
// Application-level anti-spam: only a NEW best rank per
// (subject, metric, scope, viewer) is stored.
model LeaderboardMilestone {
  id        Int      @id @default(autoincrement())
  subject   User     @relation("MilestoneSubject", fields: [subjectId], references: [id], onDelete: Cascade)
  subjectId Int
  metric    String // 'completions' | 'played' | 'reviews'
  scope     String // 'global' | 'friends'
  viewer    User?    @relation("MilestoneViewer", fields: [viewerId], references: [id], onDelete: Cascade)
  viewerId  Int? // null pour global ; l'observateur concerné pour la portée amis
  rank      Int
  createdAt DateTime @default(now())

  @@index([viewerId, createdAt])
  @@index([subjectId, createdAt])
  @@index([subjectId, metric, scope, viewerId])
}

// ---------- Game catalog (imported from IGDB) ----------

enum GameType {
  MAIN
  DLC
  EXPANSION
  STANDALONE // standalone expansion — playable without the base game
  REMAKE
  REMASTER
  OTHER
}

model Game {
  id          Int       @id @default(autoincrement())
  igdbId      Int       @unique
  title       String
  summary     String?
  releaseDate DateTime?
  coverUrl    String?
  screenshots String[]
  // IGDB aggregate rating (0-100) — used to rank the catalog before we have
  // enough user reviews of our own
  igdbRating      Float?
  igdbRatingCount Int?
  // Steam (v2): filled by the Steam-linking feature once games are mapped to
  // their AppID — will join igdbRating in the weighted catalog score
  steamAppId Int?   @unique
  // % of positive Steam reviews + how many reviews back it — the count is
  // what lets the catalog score dampen near-empty ratings
  steamScore       Float?
  steamRatingCount Int?
  // IGDB "time to beat, normally" (game_time_to_beats), in minutes. Fallback
  // signal for platforms where achievements/trophies are private or absent —
  // playtime past this average is our best guess at "finished".
  avgCompletionMinutes Int?
  // DLC system: DLCs/expansions point to their base game and are hidden from
  // the catalog list — they appear (and are reviewable) on the parent's page
  gameType GameType @default(MAIN)
  parent   Game?    @relation("GameDlcs", fields: [parentId], references: [id], onDelete: SetNull)
  parentId Int?
  dlcs     Game[]   @relation("GameDlcs")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([parentId])

  genres    Genre[]
  platforms Platform[]
  companies Company[]

  reviews   Review[]
  playedBy  PlayedGame[]
  completions GameCompletion[]
  listItems GameListItem[]
  messages  Message[]
  panoramaGuessEntries PanoramaGuessEntry[]

  translations GameTranslation[]
}

// Machine-translated cache of a game's `summary`, populated lazily on first
// view in a given language rather than pre-translating the whole catalog.
model GameTranslation {
  id          Int      @id @default(autoincrement())
  game        Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)
  gameId      Int
  language    String
  description String
  createdAt   DateTime @default(now())

  @@unique([gameId, language])
}

model Genre {
  id     Int    @id @default(autoincrement())
  igdbId Int    @unique
  name   String
  games  Game[]
}

model Platform {
  id     Int    @id @default(autoincrement())
  igdbId Int    @unique
  name   String
  games  Game[]
}

model Company {
  id      Int     @id @default(autoincrement())
  igdbId  Int     @unique
  name    String
  logoUrl String?
  games   Game[]
  // Studios are reviewable exactly like games (Review has a dual target)
  reviews Review[]
}

// ---------- Reviews & activity ----------

// A review targets EXACTLY ONE of game/company (enforced in the service
// layer — Prisma has no CHECK constraints). Likes, dislikes and threaded
// comments are shared by both targets for free.
model Review {
  id        Int      @id @default(autoincrement())
  // SetNull rather than Cascade: deleting an account keeps the content,
  // anonymised as "[deleted user]". Team decision, see docs/reviews-api.md
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  userId    Int?
  game      Game?    @relation(fields: [gameId], references: [id], onDelete: Cascade)
  gameId    Int?
  company   Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId Int?
  // Short headline, e.g. "A masterpiece of frustration"
  title     String
  // 0–10 (displayed as 5 stars with halves)
  rating    Int
  text      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  likes        ReviewLike[]
  dislikes     ReviewDislike[]
  comments     ReviewComment[]
  messages     Message[]
  translations ReviewTranslation[]
  reports      Report[]

  // One review per user per target. NULLs never collide in a Postgres unique
  // index, so each constraint only bites for its own target kind.
  @@unique([userId, gameId])
  @@unique([userId, companyId])
  // Postgres does not index FK columns automatically, and the unique indexes
  // above start with userId — useless for WHERE gameId/companyId = ?
  @@index([gameId])
  @@index([companyId])
}

// On-demand machine translation of a review's title and text (the "Translate"
// button), cached per language. Cascade-deleted with the review and invalidated
// when it is edited (see reviews.service.update).
model ReviewTranslation {
  id       Int    @id @default(autoincrement())
  review   Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  reviewId Int
  language String
  title    String
  text     String

  @@unique([reviewId, language])
}

model ReviewLike {
  id        Int      @id @default(autoincrement())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    Int
  review    Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  reviewId  Int
  createdAt DateTime @default(now())

  @@unique([userId, reviewId])
  @@index([reviewId])
}

// Like/dislike exclusivity is enforced in the service layer (transaction),
// kept as two models so "popular" sorting stays a plain likes count
model ReviewDislike {
  id        Int      @id @default(autoincrement())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    Int
  review    Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  reviewId  Int
  createdAt DateTime @default(now())

  @@unique([userId, reviewId])
  @@index([reviewId])
}

// Threaded replies under a review — nested via parent/replies (Reddit-style)
model ReviewComment {
  id        Int      @id @default(autoincrement())
  review    Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  reviewId  Int
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  userId    Int?
  text      String
  // Reddit-style tombstone: a deleted comment that has replies stays as
  // "[deleted]" (text emptied, userId null) so the thread survives
  deletedAt DateTime?

  // Null parent = top-level comment on the review
  parent    ReviewComment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  parentId  Int?
  replies   ReviewComment[] @relation("CommentReplies")

  likes    ReviewCommentLike[]
  dislikes ReviewCommentDislike[]
  reports  Report[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Covers both "top-level comments of a review" (reviewId + parentId null)
  // and "replies of a comment" (parentId)
  @@index([reviewId, parentId])
  @@index([parentId])
}

model ReviewCommentLike {
  id        Int           @id @default(autoincrement())
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    Int
  comment   ReviewComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  commentId Int
  createdAt DateTime      @default(now())

  @@unique([userId, commentId])
  @@index([commentId])
}

model ReviewCommentDislike {
  id        Int           @id @default(autoincrement())
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    Int
  comment   ReviewComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  commentId Int
  createdAt DateTime      @default(now())

  @@unique([userId, commentId])
  @@index([commentId])
}

// User-submitted report on a review or comment, queued for an admin to
// resolve (delete the content or dismiss the report) from /admin/reports.
// Exactly one of review/comment is set, matching targetType — enforced in
// the service layer, same pattern as Review's game/company split above.
model Report {
  id           Int              @id @default(autoincrement())
  reporter     User             @relation("ReportsMade", fields: [reporterId], references: [id], onDelete: Cascade)
  reporterId   Int
  targetType   ReportTargetType
  // SetNull, not Cascade: a resolved report is a moderation record — deleting
  // the reported content (the whole point of action=delete) must not also
  // wipe the report that documents the decision. Verified this the hard way:
  // with Cascade, resolving a report deleted the review, which cascaded onto
  // the just-created Report row before its own status update ran, silently
  // erasing the very row being resolved.
  review       Review?          @relation(fields: [reviewId], references: [id], onDelete: SetNull)
  reviewId     Int?
  comment      ReviewComment?   @relation(fields: [commentId], references: [id], onDelete: SetNull)
  commentId    Int?
  // Snapshot of the review/comment author at report time, captured
  // separately from review.user/comment.user — those go through the
  // content's own SetNull and (for a deleted account) get anonymised, which
  // would make banning the right person impossible once content is gone.
  targetAuthor   User?          @relation("ReportsTargetAuthor", fields: [targetAuthorId], references: [id], onDelete: SetNull)
  targetAuthorId Int?
  reason       ReportReason
  details      String?
  status       ReportStatus     @default(PENDING)
  resolvedBy   User?            @relation("ReportsResolved", fields: [resolvedById], references: [id], onDelete: SetNull)
  resolvedById Int?
  resolvedAt   DateTime?
  createdAt    DateTime         @default(now())

  // One report per user per target — TWO separate 2-column constraints, not
  // one 3-column one: a single [reporterId, reviewId, commentId] constraint
  // would never fire, since whichever of reviewId/commentId is unset is NULL
  // on every row of that target type, and NULL never equals NULL in a
  // Postgres unique index (verified: a duplicate report slipped through
  // before this fix). Same [userId, gameId]/[userId, companyId] pattern as
  // Review, just split into two declarations instead of one.
  @@unique([reporterId, reviewId])
  @@unique([reporterId, commentId])
  @@index([status])
}

// Free-form bug report / feedback from the footer button — open to guests,
// so `user` is optional and `email` covers the guest-reply case. Reviewed
// from the "Feedback" category of /admin (same page as Report, different
// tab) instead of only living in an admin's inbox.
model Feedback {
  id           Int            @id @default(autoincrement())
  user         User?          @relation("FeedbackSubmitted", fields: [userId], references: [id], onDelete: SetNull)
  userId       Int?
  email        String?
  message      String
  url          String?
  status       FeedbackStatus @default(OPEN)
  resolvedBy   User?          @relation("FeedbackResolved", fields: [resolvedById], references: [id], onDelete: SetNull)
  resolvedById Int?
  resolvedAt   DateTime?
  createdAt    DateTime       @default(now())

  @@index([status])
}

// "Done" status + date — feeds the yearly calendar and the per-game heart count
model PlayedGame {
  id       Int        @id @default(autoincrement())
  user     User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId   Int
  game     Game       @relation(fields: [gameId], references: [id], onDelete: Cascade)
  gameId   Int
  status   PlayStatus
  // The user's own "I played this" date, which may predate their account.
  // Feeds the "played" calendar.
  playedAt DateTime?
  // When the action happened, distinct from the user-chosen playedAt: orders
  // the friends' activity feed
  createdAt DateTime @default(now())
  // Who last set this row PLAYED: a platform ('steam' | 'xbox' | 'psn') when a
  // library sync did it, null for a manual mark/click. Lets unlinking a
  // platform clean up only the PLAYED rows it created, without touching ones
  // the user set by hand or that another still-linked platform also confirmed.
  source String?

  @@unique([userId, gameId])
  @@index([userId, createdAt])
}

// A catalog game completed 100% on a platform (every Steam achievement, full
// Xbox gamerscore, all PSN trophies or a platinum). Detected at library sync by
// comparing the current 100% state against the rows already stored. Drives a
// dedicated friends-feed event. `platform` is part of the key, so the same game
// completed on Steam AND PSN counts twice.
model GameCompletion {
  id       Int      @id @default(autoincrement())
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId   Int
  game     Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)
  gameId   Int
  platform String // 'steam' | 'xbox' | 'psn' | 'manual'
  // Real 100% date: latest achievement unlock (Steam), last trophy /
  // lastUpdatedDateTime (PSN), lastPlayed (Xbox), or the user's own date when
  // manual. Feeds the "completed" calendar; defaults to now for existing rows.
  completedAt DateTime @default(now())
  // Insert timestamp (detection or click): orders the activity feed,
  // independently of the real completion date.
  createdAt DateTime @default(now())

  @@unique([userId, gameId, platform])
  @@index([userId, createdAt])
  @@index([userId, completedAt])
}

// In-house achievements a user unlocked. The definition (family, tier,
// threshold, icon) lives in the code catalog (achievements.catalog.ts); only
// the unlocked key and its date are stored here. Drives the profile's
// "Achievements" section, a notification and a feed card on unlock.
model UserAchievement {
  id         Int      @id @default(autoincrement())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     Int
  key        String // catalog key, e.g. 'completions_50'
  unlockedAt DateTime @default(now())
  // Unlocked by a real action (notification + feed card) versus a silent
  // backfill or self-repair. Only `announced` rows reach the feed.
  announced  Boolean  @default(false)

  @@unique([userId, key])
  @@index([userId, unlockedAt])
}

// ---------- Custom lists ("ranked games", "horror games", ...) ----------

model GameList {
  id        Int      @id @default(autoincrement())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    Int
  name      String
  isPublic  Boolean  @default(false)
  // Image de couverture perso (upload), servie via /api/uploads/list-covers/…
  coverUrl  String?
  createdAt DateTime @default(now())

  items GameListItem[]

  @@unique([userId, name])
}

model GameListItem {
  id       Int      @id @default(autoincrement())
  list     GameList @relation(fields: [listId], references: [id], onDelete: Cascade)
  listId   Int
  game     Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)
  gameId   Int
  position Int      @default(0)

  @@unique([listId, gameId])
}

// ---------- Chat & notifications ----------

enum MessageType {
  TEXT
  GAME
  REVIEW
  PROFILE
}

model Message {
  id          Int         @id @default(autoincrement())
  sender      User        @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  senderId    Int
  recipient   User        @relation("MessageRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  recipientId Int
  type        MessageType @default(TEXT)
  // Message text, or the caption on a share — optional for a bare share.
  content     String?
  // Share references: at most one is non-null, depending on `type`. SetNull so
  // the message survives its target's deletion, just without the card.
  game         Game?   @relation(fields: [gameId], references: [id], onDelete: SetNull)
  gameId       Int?
  review       Review? @relation(fields: [reviewId], references: [id], onDelete: SetNull)
  reviewId     Int?
  sharedUser   User?   @relation("MessageSharedUser", fields: [sharedUserId], references: [id], onDelete: SetNull)
  sharedUserId Int?
  readAt      DateTime?
  createdAt   DateTime    @default(now())

  @@index([senderId, recipientId])
  @@index([recipientId, senderId])
}

model Notification {
  id        Int              @id @default(autoincrement())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    Int
  type      NotificationType
  // Contextual data (who liked, which review, ...)
  payload   Json
  readAt    DateTime?
  createdAt DateTime         @default(now())

  // The hot query: "my unread notifications"
  @@index([userId, readAt])
}

// Durable record for an ONLINE "guess the cover" match only — live gameplay
// state (rounds, turns, blur) lives in memory (CoverGuessService), same
// precedent as PresenceService. This row exists so a backend restart doesn't
// silently erase a match with no trace (a reconnecting client can be told
// "this match ended" instead of hanging) and so a GAME_INVITE notification has
// a durable target, like Friendship backs FRIEND_REQUEST. LOCAL (same-device)
// play never creates one of these.
model CoverGuessMatch {
  id           String           @id @default(cuid())
  host         User             @relation(fields: [hostId], references: [id], onDelete: Cascade)
  hostId       Int
  status       CoverGuessStatus @default(LOBBY)
  difficulty   String // "easy" | "normal" | "hard"
  targetScore  Int
  // Final snapshot only ({ userId, username, score }[]) — written at match
  // end, not per-round; no per-attempt history is tracked.
  participants Json?
  // The games that were shown during the match ({ gameId, title, coverUrl }[]),
  // for the post-match recap — written at match end alongside `participants`.
  rounds       Json?
  winnerId     Int?
  createdAt    DateTime         @default(now())
  endedAt      DateTime?
}

model ScreenshotGuessMatch {
  id           String                @id @default(cuid())
  host         User                  @relation(fields: [hostId], references: [id], onDelete: Cascade)
  hostId       Int
  status       ScreenshotGuessStatus @default(LOBBY)
  difficulty   String // "easy" | "normal" | "hard"
  targetScore  Int
  // Final snapshot only ({ userId, username, score }[]) — written at match
  // end, not per-round; no per-attempt history is tracked.
  participants Json?
  // The screenshots that were shown during the match
  // ({ gameId, title, screenshotUrl }[]), for the post-match recap —
  // written at match end alongside `participants`.
  rounds       Json?
  winnerId     Int?
  createdAt    DateTime              @default(now())
  endedAt      DateTime?
}

// Hand-curated catalogue backing panorama-guess — never populated by
// scraping Kuula's images. Each row links a Kuula post ID (the image stays
// hosted on their servers, shown in-game only via Kuula's official embed
// iframe) to the catalog game it depicts. See
// backend/src/panorama-candidates-extract.ts + panorama-seed.ts for how this
// table is populated: a review file first, a human decides what goes in.
model PanoramaGuessEntry {
  id        Int      @id @default(autoincrement())
  kuulaId   String   @unique
  game      Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)
  gameId    Int
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

model PanoramaGuessMatch {
  id           String              @id @default(cuid())
  host         User                @relation(fields: [hostId], references: [id], onDelete: Cascade)
  hostId       Int
  status       PanoramaGuessStatus @default(LOBBY)
  targetScore  Int
  participants Json?
  rounds       Json?
  winnerId     Int?
  createdAt    DateTime            @default(now())
  endedAt      DateTime?
}
