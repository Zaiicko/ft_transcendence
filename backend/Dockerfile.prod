FROM node:22-alpine

WORKDIR /app

# Dev dependencies are kept on purpose: the startup scripts (prisma db push,
# catalog:ensure) run through ts-node/prisma CLI which live in devDependencies.
COPY package*.json ./
RUN npm ci --no-audit --no-fund

COPY . .
RUN npx prisma generate && npm run build

# Same startup contract as dev (schema sync + fixture-first catalog seeding,
# see Dockerfile for the rationale) but serving the compiled dist/ build.
CMD ["sh", "-c", "npx prisma db push --accept-data-loss && npm run catalog:ensure && node dist/main"]
